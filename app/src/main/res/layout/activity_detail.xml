<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Navigation Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Menu"
                android:src="@drawable/ic_menu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="ABOUT THIS ACTIVITY"
                android:textColor="#1B5E20"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Back Button -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt; BACK"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activity Title"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Activity Image -->
        <ImageView
            android:id="@+id/imgDetailImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:contentDescription="Activity Image"
            android:src="@drawable/img_ziplining" />

        <!-- Rating Row -->
        <TextView
            android:id="@+id/tvRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="★ 4.8 (120 reviews)"
            android:textColor="#333333"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp" />

        <!-- Quick Info Specifications -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏱ 2-3 hours"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvMinAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👶 Min age: 11+"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDifficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Moderate"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Inclusions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INCLUDES:"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIncludesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Safety Briefing\n• Equipment hires\n• Professional Instructors"
            android:textColor="#333333"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Details -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DETAILS:"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Experience breathtaking views while ziplining through the forest."
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Starting Price Label -->
        <TextView
            android:id="@+id/tvStartingPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Starting from R750"
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- Book Now Button -->
        <Button
            android:id="@+id/btnBookNow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#D97706"
            android:text="BOOK NOW"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>