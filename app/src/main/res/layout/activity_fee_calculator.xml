<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Navigation -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Menu"
                android:src="@drawable/ic_menu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="FEE CALCULATOR"
                android:textColor="#1B5E20"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Back Button -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt; BACK"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Selected Activity Name -->
        <TextView
            android:id="@+id/tvSelectedActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selected Activity Name"
            android:textColor="#1B5E20"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Input 1: Number of People -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Number of Guests:"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etGuests"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Enter number of guests (e.g. 2)"
            android:inputType="number"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Checkboxes for Add-ons -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Optional Extras:"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/cbEquipment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Premium Gear &amp; Equipment Rental (+R150 per person)"
            android:textColor="#333333"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbLunch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lunch &amp; Refreshment Pack (+R200 per person)"
            android:textColor="#333333"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- Calculate Button -->
        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#1B5E20"
            android:text="CALCULATE TOTAL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Cost Breakdown Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PRICE BREAKDOWN"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvBasePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Base Rate: R0"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvExtrasCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Extras: R0"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvDiscount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Group Discount: R0"
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOTAL: R0.00"
                android:textColor="#1B5E20"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Final Confirm / Book Button -->
        <Button
            android:id="@+id/btnConfirmBooking"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#D97706"
            android:text="CONFIRM BOOKING"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>